<resources>

    <!-- Base application theme. -->
    <style name="AppThemeBase" parent="Theme.Material3.Light.NoActionBar">
    </style>
    <style name="AppThemeOverlay" parent="AppThemeBase">
    </style>

    <style name="AppTheme" parent="AppThemeOverlay">
        <item name="appBarLayoutStyle">@style/Widget.App.AppBarLayout</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
        <item name="preferenceTheme">@style/ThemeOverlay.App.Preference</item>
        <!-- DozePilot Material3 semantic palette. -->
        <item name="colorPrimary">@color/dozepilot_primary</item>
        <item name="colorPrimaryInverse">@color/dozepilot_primary_inverse</item>
        <item name="colorOnPrimary">@color/dozepilot_on_primary</item>
        <item name="colorPrimaryContainer">@color/dozepilot_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/dozepilot_on_primary_container</item>
        <item name="colorSecondary">@color/dozepilot_secondary</item>
        <item name="colorOnSecondary">@color/dozepilot_on_secondary</item>
        <item name="colorSecondaryContainer">@color/dozepilot_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/dozepilot_on_secondary_container</item>
        <item name="colorTertiary">@color/dozepilot_tertiary</item>
        <item name="colorOnTertiary">@color/dozepilot_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/dozepilot_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/dozepilot_on_tertiary_container</item>
        <item name="colorSurface">@color/dozepilot_surface</item>
        <item name="colorOnSurface">@color/dozepilot_on_surface</item>
        <item name="colorSurfaceVariant">@color/dozepilot_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/dozepilot_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/dozepilot_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/dozepilot_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/dozepilot_surface_container_highest</item>
        <item name="colorSurfaceInverse">@color/dozepilot_surface_inverse</item>
        <item name="colorOnSurfaceInverse">@color/dozepilot_on_surface_inverse</item>
        <item name="colorOutline">@color/dozepilot_outline</item>
        <item name="colorOutlineVariant">@color/dozepilot_outline_variant</item>
        <item name="android:colorBackground">@color/dozepilot_surface</item>
        <item name="colorOnBackground">@color/dozepilot_on_surface</item>

        <!-- AppCompat/M2 compatibility attributes. -->
        <item name="colorPrimaryVariant">@color/dozepilot_primary</item>
        <item name="colorAccent">@color/dozepilot_secondary</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
    </style>

    <style name="AppTheme.Launch" parent="AppTheme">
        <item name="android:windowBackground">@drawable/dozepilot_starting_window</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="Transparent.NoTitleBar" parent="Theme.Material3.Light.NoActionBar">
        <!--on below line we are setting background as transparent color-->
        <item name="android:background">@android:color/transparent</item>
        <!--on below line we are displaying the windowNotitle as true as we are not displaying our status bar-->
        <item name="android:windowNoTitle">true</item>
        <!--on below line we are setting our window background as transparent color-->
        <item name="android:windowBackground">@android:color/transparent</item>
        <!--on below line we are setting color background cache hint as null-->
        <item name="android:colorBackgroundCacheHint">@null</item>
        <!--on below line we are adding a window translucent as true-->
        <item name="android:windowIsTranslucent">true</item>
        <!--on below line we are adding a window animationstyle-->
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    <style name="ThemeOverlay.App.Preference" parent="PreferenceThemeOverlay">
        <item name="switchPreferenceCompatStyle">@style/App.Preference.SwitchPreference</item>
        <item name="preferenceCategoryTitleTextColor">@color/dozepilot_primary</item>
    </style>

    <style name="App.Preference.SwitchPreference" parent="Preference.SwitchPreference.Material">
        <item name="android:widgetLayout">@layout/my_material_switch_layout</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Toolbar</item>
        <!--        <item name="titleTextColor">@android:color/white</item>-->
        <!--        <item name="navigationIconTint">@android:color/white</item>-->
    </style>
    <style name="Widget.App.AppBarLayout" parent="Widget.Material3.AppBarLayout">
        <!-- Change the background color of the AppBarLayout so the AppBarLayout is green.
                The toolbar is transparent by default so you will see this color through the toolbar. -->
    </style>
    <style name="ThemeOverlay.App.Toolbar" parent="">
        <!--        <item name="colorControlNormal">@android:color/white</item>-->
    </style>
</resources>
